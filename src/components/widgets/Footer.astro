---
import { Icon } from 'astro-icon/components';

// Props are kept for compatibility with the layout, but the footer content lives here.
export interface Props {
  links?: unknown[];
  secondaryLinks?: unknown[];
  socialLinks?: unknown[];
  footNote?: string;
  theme?: string;
}

const EMAIL = 'egyptbeforeyougo@gmail.com';
const year = new Date().getFullYear();
---

<footer class="eb-footer">
  <div class="eb-footer__inner">
    <p class="eb-footer__closer">We want your first visit to feel like your fourth.</p>

    <a class="btn-gold eb-footer__cta" href="/trip-pass">Get the trip pass</a>

    <nav class="eb-footer__links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/egypt-films">Egypt films</a>
      <a href="/trip-pass">Trip pass</a>
      <a href="/beyond-egypt">Beyond Egypt</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <ul class="eb-footer__social">
      <li>
        <a href="https://youtube.com/@slideshowalchemist758" aria-label="YouTube" target="_blank" rel="noopener">
          <Icon name="tabler:brand-youtube" class="w-6 h-6" />
        </a>
      </li>
      <li>
        <a href="https://www.instagram.com/slideshow_alchemist/" aria-label="Instagram" target="_blank" rel="noopener">
          <Icon name="tabler:brand-instagram" class="w-6 h-6" />
        </a>
      </li>
      <li>
        <a href={`mailto:${EMAIL}`} aria-label="Email">
          <Icon name="tabler:mail" class="w-6 h-6" />
        </a>
      </li>
    </ul>

    <p class="eb-footer__email"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    <p class="eb-footer__small">© {year} Egypt Before You Go · Rick &amp; Trena</p>
  </div>
</footer>

<style>
  .eb-footer {
    background: var(--lapis-dark);
    color: var(--papyrus-dark);
    border-top: 3px solid var(--gold);
    text-align: center;
    padding: 56px 24px 40px;
  }
  .eb-footer__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .eb-footer__closer {
    font-family: 'Cinzel', serif;
    color: var(--gold-bright);
    font-size: 1.25rem;
    margin: 0 0 20px;
  }
  .eb-footer__cta {
    padding: 10px 22px;
    font-size: 0.95rem;
  }
  .eb-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    margin: 32px 0 20px;
    font-size: 0.9rem;
  }
  .eb-footer__links a,
  .eb-footer__email a {
    color: var(--papyrus);
    text-decoration: none;
  }
  .eb-footer__links a:hover,
  .eb-footer__email a:hover,
  .eb-footer__social a:hover {
    color: var(--gold-bright);
  }
  .eb-footer__social {
    display: flex;
    justify-content: center;
    gap: 18px;
    list-style: none;
    padding: 0;
    margin: 0 0 10px;
  }
  .eb-footer__social a {
    color: var(--papyrus-dark);
  }
  .eb-footer__email {
    font-size: 0.9rem;
    margin: 6px 0;
  }
  .eb-footer__small {
    font-size: 0.78rem;
    opacity: 0.7;
    margin-top: 18px;
  }
</style>
