---
// The trip pass offer box: what's inside, the price, and the buy button. Used on the
// home page and the trip pass page so the offer always reads the same.
import BuyButton from '~/components/trip-pass/BuyButton.astro';
import { PASS_PRICE } from '~/lib/sites';

export interface Props {
  siteCount: number;
}
const { siteCount } = Astro.props;
---

<div class="offer card" id="get-the-pass">
  <span class="eyebrow">One price · one year</span>
  <h2>The Egypt trip pass</h2>
  <ul>
    <li>Our honest verdict on {siteCount} sites across nine regions, from four visits and counting</li>
    <li>What it's really like to stand there, and how long to allow</li>
    <li>Getting there, tickets and practical tips, updated after every trip</li>
    <li>Our own footage for each site, so you can see it before you decide</li>
  </ul>
  <p class="price">{PASS_PRICE} <span>· 12 months access</span></p>
  <BuyButton />
</div>

<style>
  .offer {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    border: 1px solid var(--gold);
  }
  .offer ul {
    text-align: left;
    margin: 16px auto;
    max-width: 440px;
  }
  .offer li {
    margin-bottom: 6px;
  }
  .price {
    font-family: 'Cinzel', serif;
    font-size: 1.7rem;
    color: var(--lapis);
    margin: 18px 0 14px !important;
  }
  .price span {
    font-family: 'Lato', sans-serif;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
</style>
