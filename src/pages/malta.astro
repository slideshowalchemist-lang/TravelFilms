---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Malta - Travel Chronicles Studio',
};
---

<Layout metadata={metadata}>

  <!-- HERO -->
  <section class="relative flex items-center justify-center min-h-[60vh] text-center px-6 overflow-hidden">

    <div class="absolute inset-0">
      <img src="/Images/malta/malta_thumb.png" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/50"></div>
    </div>

    <div class="relative z-10 text-white">
      <h1 class="text-5xl md:text-6xl font-bold">Malta</h1>
      <p class="mt-4 text-lg opacity-90">Sunlit island of ancient temples, turquoise bays, baroque cities, rich history, warm hospitality, Mediterranean charm</p>
    </div>

  </section>

  <!-- CONTENT -->
  <section id="highlights" class="max-w-4xl mx-auto px-6 pt-5 pb-0">

    <h2 class="text-2xl font-bold mb-6"></h2>

    <div class="grid md:grid-cols-3 gap-6">

      <!-- Malta 2025 card -->
      <div onclick="openModal('/OUKE6-y0KjI')" class="cursor-pointer group block overflow-hidden rounded-2xl">
        <img src="/Images/malta/malta1.png" class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition duration-700" alt="Malta 2025" />
        <div class="p-4">
          <p class="text-sm opacity-80 leading-relaxed">
            <span class="font-semibold text-base block mb-1"></span>
            Malta doesn't demand anything from you. We spent several days wandering Valletta's sun-warmed limestone streets, cruising the Grand Harbour past ancient fortified walls, swimming at St Peter's Pool on the south coast, and sailing out to Comino's impossibly blue lagoon. A slow travel film from one of the Mediterranean's most quietly remarkable islands. [2025].
          </p>
          <span class="text-sm font-semibold underline mt-2 inline-block">▶ Watch video</span>
        </div>
      </div>

    </div>

  </section>

  <!-- VIDEO MODAL -->
  <div
    id="videoModal"
    class="fixed inset-0 bg-black/80 hidden z-50 items-center justify-center backdrop-blur-sm"
  >

    <div class="relative w-full max-w-4xl aspect-video transform transition-all duration-300 scale-95">

      <!-- Close button -->
      <button
        onclick="closeModal()"
        class="absolute -top-10 right-0 text-white text-2xl"
      >
        ✕
      </button>

      <!-- YouTube iframe -->
      <iframe
        id="videoFrame"
        class="w-full h-full rounded-xl"
        src=""
        frameborder="0"
        allow="autoplay; fullscreen"
        allowfullscreen
      ></iframe>

    </div>

  </div>

  <!-- CSS -->
  <style>
    .map-pin {
      display: none;
    }
  </style>

  <script is:inline>
    window.openModal = function(videoId) {
      const modal = document.getElementById('videoModal');
      const frame = document.getElementById('videoFrame');
      const inner = modal.querySelector('div');

      frame.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;

      modal.classList.remove('hidden');
      modal.classList.add('flex');

      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        inner.classList.remove('scale-95');
        inner.classList.add('scale-100');
      });
    };

    window.closeModal = function() {
      const modal = document.getElementById('videoModal');
      const frame = document.getElementById('videoFrame');
      const inner = modal.querySelector('div');

      frame.src = '';

      inner.classList.add('scale-95');
      inner.classList.remove('scale-100');

      modal.classList.add('hidden');
      modal.classList.remove('flex');

      document.body.style.overflow = 'auto';
    };
  </script>

</Layout>
