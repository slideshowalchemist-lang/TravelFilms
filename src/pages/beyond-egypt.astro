---
import Layout from '~/layouts/TripPassLayout.astro';
import { JOURNEYS } from '~/data/journeys';
import { thumbUrl, watchUrl } from '~/lib/sites';
import { TRIP_PASS_OPEN } from '~/data/tripPassStatus';

// Country pages (photo tiles), A–Z. Images are the ones the old home page used.
const COUNTRY_PAGES = [
  { name: 'Australia', href: '/australia', img: '/Images/australia/australia_thumb.png' },
  { name: 'Cook Islands', href: '/cookislands', img: '/Images/cookislands/cook_island_thumb.png' },
  { name: 'Croatia', href: '/croatia', img: '/Images/croatia/croatia_thumb.png' },
  { name: 'England', href: '/england', img: '/Images/england/england_thumb.png' },
  { name: 'France', href: '/france', img: '/Images/france/france_thumb.png' },
  { name: 'Greece', href: '/greece', img: '/Images/greece/santorini_thumb.png' },
  { name: 'Italy', href: '/italy', img: '/Images/italy/italy_thumb.png' },
  { name: 'Jordan', href: '/jordan', img: '/Images/jordan/jordan_thumb.png' },
  { name: 'Malta', href: '/malta', img: '/Images/malta/malta_thumb.png' },
  { name: 'Morocco', href: '/morocco', img: '/Images/morocco/morocco_thumb.png' },
  { name: 'Netherlands', href: '/netherlands', img: '/Images/netherlands/netherlands_thumb.jpg' },
  { name: 'Portugal', href: '/portugal', img: '/Images/portugal/portugal_thumb.png' },
  { name: 'Qatar', href: '/qatar', img: '/Images/qatar/qatar_thumb.png' },
  { name: 'Sicily', href: '/sicily', img: '/Images/sicily/sicily.png' },
  { name: 'Spain', href: '/spain', img: '/Images/spain/spain.png' },
  { name: 'Switzerland', href: '/switzerland', img: '/Images/switzerland/switzerland_thumb.png' },
  { name: 'United Arab Emirates', href: '/uae', img: '/Images/uae/uae_thumb.png' },
  { name: 'USA', href: '/usa', img: '/Images/usa/usa_thumb.png' },
];

// Films: newest first within each country; countries A–Z.
const countries = [...JOURNEYS]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((c) => ({ ...c, videos: [...c.videos].sort((a, b) => (b.year ?? 0) - (a.year ?? 0)) }));
const anchor = (name: string) => name.toLowerCase().replace(/\s+/g, '-');
---

<Layout title="Beyond Egypt" description="Travel films from the other countries we've explored." wide>
  <span class="eyebrow">Beyond Egypt</span>
  <h1>Our other journeys</h1>
  <p class="intro">
    Egypt is where our hearts are, but it isn't the only place we've pointed a camera. Pick a country, or scroll down to
    watch our films from each one.
  </p>

  <div class="tiles">
    {
      COUNTRY_PAGES.map((c) => (
        <a class="tile" href={c.href}>
          <img src={c.img} alt="" loading="lazy" />
          <span class="shade" />
          <span class="name">{c.name}</span>
        </a>
      ))
    }
  </div>

  <h2 class="films-heading">Films by country</h2>
  <nav class="jump" aria-label="Countries">
    {countries.map((c) => <a href={`#${anchor(c.name)}`}>{c.name}</a>)}
  </nav>

  {
    countries.map((c) => (
      <section id={anchor(c.name)}>
        <h3>{c.name}</h3>
        {c.tagline && <p class="tagline">{c.tagline}</p>}
        <div class="grid">
          {c.videos.map((v) => (
            <a class="film" href={watchUrl(v.id)} target="_blank" rel="noopener">
              <span class="img">
                <img src={thumbUrl(v.id)} alt="" loading="lazy" />
                <span class="play" aria-hidden="true">
                  ▶
                </span>
              </span>
              <span class="title">
                {v.title}
                {v.year && <span class="year"> · {v.year}</span>}
              </span>
              {v.blurb && <span class="blurb">{v.blurb}</span>}
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <p class="back card">
    Planning Egypt?{' '}
    {TRIP_PASS_OPEN ? <a href="/trip-pass">See the Egypt trip pass →</a> : <a href="/egypt-films">Watch our Egypt films →</a>}
  </p>
</Layout>

<style>
  .intro {
    max-width: 680px;
    color: var(--ink-soft);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    margin: 24px 0 48px;
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 16/10;
    border-radius: 8px;
    overflow: hidden;
    background: var(--lapis-dark);
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .tile:hover img {
    transform: scale(1.08);
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 42, 64, 0.75), transparent 60%);
  }
  .name {
    position: absolute;
    left: 12px;
    bottom: 10px;
    color: #fff;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .films-heading {
    border-top: 2px solid var(--gold);
    padding-top: 28px;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 8px;
  }
  .jump a {
    font-size: 0.8rem;
    text-decoration: none;
    padding: 3px 10px;
    border: 1px solid var(--sandstone);
    border-radius: 999px;
  }
  .jump a:hover {
    background: var(--dark-chocolate);
    color: var(--papyrus);
    border-color: var(--dark-chocolate);
  }
  section {
    margin-top: 36px;
    scroll-margin-top: 90px;
  }
  section h3 {
    font-size: 1.2rem;
    margin: 0 0 2px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--gold);
  }
  .tagline {
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin: 6px 0 0 !important;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
    margin-top: 14px;
  }
  .film {
    text-decoration: none;
    color: inherit !important;
    display: block;
  }
  .img {
    position: relative;
    display: block;
    aspect-ratio: 16/9;
    border-radius: 4px;
    overflow: hidden;
    background: var(--lapis-dark);
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .film:hover .img img {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgba(30, 26, 23, 0.82);
    color: var(--gold-bright);
    display: grid;
    place-items: center;
  }
  .title {
    display: block;
    font-weight: 700;
    margin-top: 8px;
    font-size: 0.95rem;
  }
  .year {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .blurb {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-top: 2px;
  }
  .back {
    margin-top: 48px;
    text-align: center;
  }
</style>
